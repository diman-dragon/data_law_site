{% macro section(label, title, class='', style='') %}
<section class="page-section {{ class }}" style="{{ style }}">
  <div class="container">
    {% if label or title %}
    <div style="margin-bottom: var(--space-lg);">
      {% if label %}<div class="block-label">{{ label }}</div>{% endif %}
      {% if title %}<h2 style="font-size: 2.5rem; margin-top: 0;">{{ title | safe }}</h2>{% endif %}
    </div>
    {% endif %}
    {{ caller() }}
  </div>
</section>
{% endmacro %}
