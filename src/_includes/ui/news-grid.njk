{% macro news_grid(params) %}
<div class="news-grid">
  <div class="container">
    {% if params.title or params.label %}
      <div class="news-grid__header">
        {% if params.label %}<div class="label">{{ params.label }}</div>{% endif %}
        {% if params.title %}<h2 class="text-h2">{{ params.title | safe }}</h2>{% endif %}
      </div>
    {% endif %}
    <div class="grid grid-3 gap-8">
      {{ caller() if caller }}
    </div>
  </div>
</div>
{% endmacro %}
