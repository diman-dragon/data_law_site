{% from "ui/card.njk" import card %}

{% macro article_card(params) %}
{% call card({ href: params.href, class: "h-full" }) %}
  <div class="text-overline text-overline--gold mb-4">{{ params.category }}</div>
  <h3 class="dl-card__title mb-4">{{ params.title }}</h3>
  <p class="dl-card__desc mb-6">{{ params.excerpt }}</p>
  <span class="text-link font-semibold">Читать полностью →</span>
{% endcall %}
{% endmacro %}
