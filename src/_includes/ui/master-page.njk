{% from "ui/button.njk" import button %}
{% from "ui/card.njk" import card %}
{% from "ui/hero.njk" import hero %}
{% from "ui/section.njk" import section %}

{% macro detail_group(group, bg) %}
  {% set groupLayout = group.layout or "cards" %}
  {% set columns = group.columns or (2 if groupLayout == "text" else 3) %}

  <div class="mt-12">
    {% if group.eyebrow %}
      <div class="text-overline{% if bg == 'dark' %} text-overline--white{% else %} text-overline--gold{% endif %} mb-3">{{ group.eyebrow }}</div>
    {% endif %}

    {% if group.title %}
      <h3 class="text-h3 mb-4{% if bg == 'dark' %} text-white{% endif %}">{{ group.title }}</h3>
    {% endif %}

    {% if group.text %}
      <p class="mb-8{% if bg == 'dark' %} text-white{% endif %}">{{ group.text | safe }}</p>
    {% endif %}

    {% if group.items and group.items.length %}
      {% if groupLayout == "text" %}
        <div class="grid grid-{{ columns }} gap-12">
          {% for item in group.items %}
            <div>
              {% if item.eyebrow %}
                <div class="text-overline{% if bg == 'dark' %} text-overline--white{% else %} text-overline--gold{% endif %} mb-3">{{ item.eyebrow }}</div>
              {% endif %}
              {% if item.title %}
                <h4 class="text-h3 mb-4{% if bg == 'dark' %} text-white{% endif %}">{{ item.title }}</h4>
              {% endif %}
              {% if item.text %}
                <p{% if bg == 'dark' %} class="text-white"{% endif %}>{{ item.text | safe }}</p>
              {% endif %}
              {% if item.points %}
                <ul class="feature-list{% if bg == 'dark' %} text-white{% endif %}">
                  {% for point in item.points %}
                    <li>{{ point }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% elif groupLayout == "actions" %}
        <div class="flex gap-4">
          {% for item in group.items %}
            {{ button({
              text: item.title,
              href: item.href,
              type: item.type or "primary",
              trigger: item.trigger
            }) }}
          {% endfor %}
        </div>
      {% else %}
        <div class="grid grid-{{ columns }} gap-8">
          {% for item in group.items %}
            {% if item.points %}
              {% call card({
                label: item.eyebrow,
                title: item.title,
                description: item.text,
                href: item.href,
                dark: bg == "dark"
              }) %}
                <ul class="feature-list{% if bg == 'dark' %} text-white{% endif %}">
                  {% for point in item.points %}
                    <li>{{ point }}</li>
                  {% endfor %}
                </ul>
              {% endcall %}
            {% else %}
              {{ card({
                label: item.eyebrow,
                title: item.title,
                description: item.text,
                href: item.href,
                footer: item.footer,
                dark: bg == "dark"
              }) }}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}
  </div>
{% endmacro %}

{% macro master_page(page) %}
  {% if page.layout == "workspace" %}
    <div class="dl-search-workspace">
      <div class="dl-search-workspace__chat">
        <div class="dl-chat-container">
          {% for msg in page.workspace.chat %}
            <div class="dl-msg dl-msg--{{ msg.role }}">
              <div class="dl-msg__avatar">{{ "AI" if msg.role == "ai" else "You" }}</div>
              <div class="dl-msg__content">
                <p>{{ msg.text | safe }}</p>
                {% if msg.citations %}
                  <div class="dl-msg__citations">
                    {% for cite in msg.citations %}
                      <button class="cite-trigger" data-cite-id="{{ cite.id }}">[{{ cite.id }}] {{ cite.title }}</button>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
        <div class="dl-chat-input-area">
          <input type="text" placeholder="{{ page.workspace.placeholder }}">
          <button class="dl-chat-send">Отправить</button>
        </div>
      </div>
      <div class="dl-search-workspace__context" id="context-panel">
        <div class="dl-context-placeholder">
          <p>Выберите ссылку в чате, чтобы просмотреть документ</p>
        </div>
        {% for msg in page.workspace.chat %}
          {% if msg.citations %}
            {% for cite in msg.citations %}
              <div class="dl-context-item hidden" id="cite-{{ cite.id }}">
                <div class="dl-context-header">
                  <h3 class="text-overline">Источник [{{ cite.id }}]</h3>
                  <p class="text-sm font-bold">{{ cite.title }}</p>
                </div>
                <div class="dl-context-body">
                  {{ cite.content | safe }}
                </div>
              </div>
            {% endfor %}
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const triggers = document.querySelectorAll('.cite-trigger');
        const contextItems = document.querySelectorAll('.dl-context-item');
        const placeholder = document.querySelector('.dl-context-placeholder');

        triggers.forEach(trigger => {
          trigger.addEventListener('click', () => {
            const id = trigger.getAttribute('data-cite-id');
            if (placeholder) placeholder.classList.add('hidden');
            contextItems.forEach(item => item.classList.add('hidden'));
            const target = document.getElementById(`cite-${id}`);
            if (target) target.classList.remove('hidden');
          });
        });
      });
    </script>
  {% else %}
    {{ hero(page.hero) }}

    {% if page.band %}
      <div class="dl-band">
        <div class="dl-band__inner">
          <span class="dl-band__tag">{{ page.band.tag }}</span>
          <span class="dl-band__text">{{ page.band.text }}</span>
        </div>
      </div>
    {% endif %}

    {% if page.news and page.news.main %}
      <section class="dl-section dl-section--base">
        <div class="container">
          <div class="dl-section__header home-news-header">
            <div>
              <div class="text-overline text-overline--gold dl-section__label">{{ page.news.label }}</div>
              <h2 class="dl-section__title">{{ page.news.title }}</h2>
            </div>
            {% if page.news.href and page.news.linkText %}
              <a href="{{ page.news.href | url }}" class="home-news-all">{{ page.news.linkText }}</a>
            {% endif %}
          </div>

          <div class="home-news-grid">
            <article class="home-news-main">
              <div class="home-news-main__tag">
                <span class="home-news-main__tag-line"></span>
                {{ page.news.main.tag }}
              </div>
              <a href="{{ page.news.main.href | url }}" class="home-news-main__title">
                {{ page.news.main.title }}
              </a>
              <p class="home-news-main__lead">{{ page.news.main.lead }}</p>
              <time class="home-news-main__date">{{ page.news.main.date }}</time>
            </article>

            <div class="home-news-side">
              {% for item in page.news.side %}
                <article class="home-news-side__item">
                  <div class="text-overline text-overline--gold">{{ item.label }}</div>
                  <a href="{{ item.href | url }}" class="home-news-side__title">{{ item.title }}</a>
                  <time class="home-news-side__date">{{ item.date }}</time>
                </article>
              {% endfor %}
            </div>
          </div>
        </div>
      </section>
    {% endif %}

    {% if page.feature and page.feature.items and page.feature.items.length %}
      <section class="dl-section dl-section--dark">
        <div class="container">
          <div class="home-tech-grid">
            <div class="home-tech-left">
              <div class="text-overline text-overline--gold dl-section__label">{{ page.feature.label }}</div>
              <h2 class="dl-section__title text-white">{{ page.feature.title | safe }}</h2>
            </div>

            <div class="home-tech-features">
              {% for item in page.feature.items %}
                <div class="home-tech-feature">
                  <span class="home-tech-feature__num">{{ item.num }}</span>
                  <div>
                    <div class="home-tech-feature__title">{{ item.title }}</div>
                    <p class="home-tech-feature__text">{{ item.text }}</p>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </section>
    {% endif %}

    {% if page.tools and page.tools.length %}
      <section class="dl-section dl-section--base pt-0">
        <div class="container">
          <div class="home-tools-grid">
            {% for item in page.tools %}
              <a href="{{ item.href | url }}" class="home-tool{% if item.dark %} home-tool--dark{% endif %}">
                <div class="home-tool__num">{{ item.num }}</div>
                <div class="home-tool__title">{{ item.title }}</div>
                <p class="home-tool__desc">{{ item.desc }}</p>
                <span class="home-tool__arrow">→</span>
              </a>
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}

    {% if page.details %}
      {% call section({
        label: page.details.label,
        title: page.details.title,
        description: page.details.description,
        bg: page.details.bg or "white"
      }) %}
        {% if page.details.groups %}
          {% for group in page.details.groups %}
            {{ detail_group(group, page.details.bg or "white") }}
          {% endfor %}
        {% elif page.details.items %}
          {{ detail_group({
            items: page.details.items,
            layout: page.details.layout or "cards",
            columns: page.details.columns
          }, page.details.bg or "white") }}
        {% endif %}
      {% endcall %}
    {% endif %}
  {% endif %}
{% endmacro %}
