<div class="layla-container" id="laylaWidget" style="position: fixed; bottom: 30px; right: 30px; z-index: 999999;">
  <div class="layla-window" id="laylaWindow">
    <div class="layla-header">
      <div>
        <span class="status-live" style="font-size: 10px; letter-spacing: 0.1em;">● ONLINE</span>
        <h4>ЛАЙЛА / AI-АССИСТЕНТ</h4>
      </div>
      <button id="laylaClose" type="button" style="background:none; border:none; color:#c5a87c; font-size:1.8rem; cursor:pointer; line-height:1;">&times;</button>
    </div>
    <div class="layla-messages" id="laylaMsgs">
      <div class="msg ai">Я Лайла. Система готова к анализу данных DataLaw. Какой у вас запрос?</div>
    </div>
    <div class="layla-input-area">
      <input type="text" class="layla-input" id="laylaIn" placeholder="Интерпол, экстрадиция..." autocomplete="off">
      <button class="layla-send" id="laylaSend" type="button">SEND</button>
    </div>
  </div>

  <button class="layla-trigger" id="laylaTrigger" type="button" style="padding: 0; display: flex; align-items: center; justify-content: center;">
    <svg class="orbital-system" viewBox="0 0 100 100" style="width: 55px; height: 55px; pointer-events: none;">
      <circle cx="50" cy="50" r="4" fill="#c5a87c" />
      <g class="orbit-1">
        <circle class="orbit" cx="50" cy="50" r="20" fill="none" stroke="rgba(197, 168, 124, 0.4)" stroke-width="0.8" />
        <circle class="satellite" cx="70" cy="50" r="2.5" fill="#c5a87c" />
      </g>
      <g class="orbit-2">
        <circle class="orbit" cx="50" cy="50" r="32" fill="none" stroke="rgba(197, 168, 124, 0.4)" stroke-width="0.8" stroke-dasharray="2, 4" />
        <circle class="satellite" cx="18" cy="50" r="2" fill="#c5a87c" />
      </g>
      <g class="orbit-3">
        <circle class="orbit" cx="50" cy="50" r="44" fill="none" stroke="rgba(197, 168, 124, 0.4)" stroke-width="0.8" />
        <circle class="satellite" cx="50" cy="6" r="3" fill="#c5a87c" />
      </g>
    </svg>
  </button>
</div>