<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | DATALAW</title>
  
  <link rel="icon" type="image/jpg" href="{{ '/assets/logo.jpg' | url }}">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500;600&family=Playfair+Display:ital@1&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="{{ '/css/global.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/header.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/footer.css' | url }}">

  <style>
    .layla-container { position: fixed; bottom: 30px; right: 30px; z-index: 10000; font-family: 'Jost', sans-serif; }
    .layla-trigger {
      background: var(--navy); color: white; border: 1px solid var(--gold);
      padding: 14px 28px; border-radius: 50px; cursor: pointer;
      display: flex; align-items: center; gap: 12px;
      box-shadow: 0 15px 35px rgba(15, 36, 68, 0.2);
      transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
      position: relative; overflow: hidden;
    }
    .layla-window {
      position: absolute; bottom: 80px; right: 0; width: 380px;
      background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(10px);
      border-radius: 12px; display: none; flex-direction: column;
      box-shadow: 0 30px 60px rgba(15, 36, 68, 0.15);
      border: 1px solid var(--border); overflow: hidden;
    }
    .layla-container.active .layla-window { display: flex; }
    .layla-container.active .layla-trigger { opacity: 0; pointer-events: none; }
    .layla-header { background: var(--navy); padding: 25px; display: flex; align-items: center; gap: 15px; color: white; }
    .layla-chat { height: 380px; overflow-y: auto; padding: 25px; display: flex; flex-direction: column; gap: 15px; }
    .msg.ai { border-left: 3px solid var(--gold); padding: 10px; background: #f9f9f9; }
    .msg.user { background: var(--navy); color: white; align-self: flex-end; padding: 10px; border-radius: 4px; }
    .layla-input-area { padding: 20px; border-top: 1px solid var(--border); display: flex; gap: 10px; }
    .layla-input-area input { flex: 1; border: none; outline: none; }
  </style>
</head>
<body>

  {% include "header.html" %}

  <main>
    {{ content | safe }}
  </main>

  <div class="layla-container" id="laylaWrapper">
    <div class="layla-window">
      <div class="layla-header">
        <div style="width:40px; height:40px; background:var(--gold); border-radius:50%; display:flex; align-items:center; justify-content:center; color:var(--navy); font-weight:bold;">L</div>
        <div>
          <span style="display:block; font-weight:600;">Лайла</span>
          <span style="font-size:0.7rem; color:var(--gold);">Justice AI</span>
        </div>
        <button id="laylaClose" style="margin-left:auto; background:none; border:none; color:white; cursor:pointer; font-size:1.5rem;">&times;</button>
      </div>
      <div class="layla-chat" id="laylaChat">
        <div class="msg ai">Приветствую. Я Лайла. Чем могу помочь?</div>
      </div>
      <div class="layla-input-area">
        <input type="text" id="laylaInput" placeholder="Задайте вопрос...">
        <button id="laylaSend" style="background:var(--navy); color:white; border:none; padding:10px; border-radius:4px; cursor:pointer;">➔</button>
      </div>
    </div>
    <button class="layla-trigger" id="laylaOpen">✦ Спросить Лайлу</button>
  </div>

  {% include "footer.html" %}

  <script>
    const wrapper = document.getElementById('laylaWrapper');
    const input = document.getElementById('laylaInput');
    const chat = document.getElementById('laylaChat');
    let laylaDB = {};

    // ПУТЬ К JSON ТОЖЕ ЧЕРЕЗ ФИЛЬТР
    fetch("{{ '/js/layla-db.json' | url }}")
      .then(res => res.json())
      .then(data => { laylaDB = data.responses; })
      .catch(e => console.error("DB Error:", e));

    document.getElementById('laylaOpen').onclick = () => wrapper.classList.add('active');
    document.getElementById('laylaClose').onclick = () => wrapper.classList.remove('active');

    function speak(text, type) {
      const d = document.createElement('div');
      d.className = `msg ${type}`;
      d.innerHTML = text;
      chat.appendChild(d);
      chat.scrollTop = chat.scrollHeight;
    }

    document.getElementById('laylaSend').onclick = () => {
      const val = input.value.trim();
      if(!val) return;
      speak(val, 'user');
      input.value = '';
      setTimeout(() => {
        const low = val.toLowerCase();
        let answer = "Я пока изучаю этот вопрос...";
        for (let id in laylaDB) {
          if (laylaDB[id].keys.some(k => low.includes(k))) {
            answer = laylaDB[id].text;
            break;
          }
        }
        speak(answer, 'ai');
      }, 600);
    };
  </script>

  <script src="{{ '/js/main.js' | url }}"></script>
</body>
</html>