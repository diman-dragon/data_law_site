<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | DATALAW</title>
  
  <link rel="icon" type="image/jpg" href="/assets/logo.jpg">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500;600&family=Playfair+Display:ital@1&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">

  <style>
    /* LAYLA BEAUTY UI */
    .layla-container { position: fixed; bottom: 30px; right: 30px; z-index: 10000; font-family: 'Jost', sans-serif; }

    /* Кнопка — изящная и живая */
    .layla-trigger {
      background: var(--navy);
      color: white;
      border: 1px solid var(--gold);
      padding: 14px 28px;
      border-radius: 50px;
      cursor: pointer;
      display: flex; align-items: center; gap: 12px;
      box-shadow: 0 15px 35px rgba(15, 36, 68, 0.2);
      transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
      position: relative; overflow: hidden;
    }

    .layla-trigger::after {
      content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
      background: linear-gradient(45deg, transparent, rgba(184, 145, 58, 0.1), transparent);
      transform: rotate(45deg); animation: shimmer 4s infinite;
    }

    .layla-trigger:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(15, 36, 68, 0.3); }

    .layla-window {
      position: absolute; bottom: 80px; right: 0; width: 380px;
      background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(10px);
      border-radius: 12px; display: none; flex-direction: column;
      box-shadow: 0 30px 60px rgba(15, 36, 68, 0.15);
      border: 1px solid var(--border); overflow: hidden;
    }

    .layla-container.active .layla-window { display: flex; animation: laylaAppear 0.5s cubic-bezier(0.165, 0.84, 0.44, 1); }
    .layla-container.active .layla-trigger { opacity: 0; pointer-events: none; }

    .layla-header {
      background: var(--navy); padding: 25px; display: flex; align-items: center; gap: 15px; color: white;
    }

    .layla-avatar {
      width: 45px; height: 45px; background: var(--gold); border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; font-weight: 600;
    }

    .layla-chat {
      height: 380px; overflow-y: auto; padding: 25px; display: flex; flex-direction: column; gap: 15px;
      background: linear-gradient(to bottom, #fff, #f9fafb);
    }

    .layla-chat .msg { font-size: 0.9rem; line-height: 1.5; padding: 12px 18px; border-radius: 4px; max-width: 85%; }
    .layla-chat .msg.ai { background: #fff; border-left: 3px solid var(--gold); color: var(--text); box-shadow: 0 2px 5px rgba(0,0,0,0.03); }
    .layla-chat .msg.user { background: var(--navy); color: white; align-self: flex-end; }

    .layla-input-area { padding: 20px; border-top: 1px solid var(--border); display: flex; gap: 10px; background: #fff; }
    .layla-input-area input { flex: 1; border: none; font-size: 0.95rem; outline: none; font-family: inherit; }

    @keyframes shimmer { 0% { left: -100%; } 100% { left: 100%; } }
    @keyframes laylaAppear { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</head>
<body>

  {% include "header.html" %}

  <main>
    {{ content | safe }}
  </main>

  <div class="layla-container" id="laylaWrapper">
    <div class="layla-window">
      <div class="layla-header">
        <div class="layla-avatar">L</div>
        <div class="layla-info">
          <span class="layla-name" style="display: block; font-weight: 600;">Лайла</span>
          <span class="layla-status" style="font-size: 0.65rem; color: var(--gold); text-transform: uppercase;">Justice Intelligence</span>
        </div>
        <button class="layla-close" id="laylaClose" style="margin-left:auto; background:none; border:none; color:#fff; font-size:20px; cursor:pointer;">&times;</button>
      </div>
      <div class="layla-chat" id="laylaChat">
        <div class="msg ai">Приветствую. Я — Лайла. Начитанная, спокойная и готовая помочь вам в мире больших данных и прав человека. О чем мы поговорим?</div>
      </div>
      <div class="layla-input-area">
        <input type="text" id="laylaInput" placeholder="Ваш запрос...">
        <button id="laylaSend" class="btn-send-ai" style="padding: 10px; height: auto;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
        </button>
      </div>
    </div>
    
    <button class="layla-trigger" id="laylaOpen">
      <span style="color: var(--gold); font-size: 1.2rem;">✦</span>
      <span style="font-weight: 600; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em;">Спросить Лайлу</span>
    </button>
  </div>

  {% include "footer.html" %}

  <script>
    const wrapper = document.getElementById('laylaWrapper');
    const input = document.getElementById('laylaInput');
    const chat = document.getElementById('laylaChat');
    let laylaDB = {};

    // Загрузка базы ответов
    fetch('/js/layla-db.json')
      .then(res => res.json())
      .then(data => { laylaDB = data.responses; })
      .catch(e => console.error("Ошибка загрузки базы Лайлы:", e));

    document.getElementById('laylaOpen').onclick = () => wrapper.classList.add('active');
    document.getElementById('laylaClose').onclick = () => wrapper.classList.remove('active');

    function speak(text, type) {
      const d = document.createElement('div');
      d.className = `msg ${type}`;
      d.innerHTML = type === 'ai' ? `<strong>Лайла:</strong> ${text}` : text;
      chat.appendChild(d);
      chat.scrollTop = chat.scrollHeight;
    }

    document.getElementById('laylaSend').onclick = () => {
      const val = input.value.trim();
      if(!val) return;
      speak(val, 'user');
      input.value = '';

      setTimeout(() => {
        const low = val.toLowerCase();
        let answer = "Прошу прощения, я еще не нашла нужный фолиант в нашей библиотеке, чтобы ответить на это. Но я могу рассказать об Интерполе или нашей миссии.";
        
        for (let id in laylaDB) {
          if (laylaDB[id].keys.some(k => low.includes(k))) {
            answer = laylaDB[id].text;
            break;
          }
        }
        speak(answer, 'ai');
      }, 700);
    };

    input.onkeydown = (e) => { if(e.key === 'Enter') document.getElementById('laylaSend').click(); };
  </script>

  <script src="/js/main.js"></script>
</body>
</html>