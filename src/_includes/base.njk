<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | {{ site.title if site.title else "DATALAW" }}</title>

  {# 1. ШРИФТЫ (Загружаются первыми) #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400&family=Jost:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  {# 2. ГЛОБАЛЬНЫЙ ФУНДАМЕНТ (Сброс, Цвета, Типографика) #}
  <link rel="stylesheet" href="/css/global.css">

  {# 3. АРХИТЕКТУРА СТРАНИЦ (Сетки, Hero-блоки, Секции) #}
  <link rel="stylesheet" href="/css/pages.css">

  {# 4. КОМПОНЕНТЫ (Специфичные блоки) #}
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/layla-widget.css">

  {# 5. ДОПОЛНИТЕЛЬНЫЕ СТИЛИ СТРАНИЦЫ (Если заданы в Frontmatter) #}
  {% if css %}
    <link rel="stylesheet" href="/css/{{ css }}.css">
  {% endif %}
</head>
<body class="site-body">

  {# ХЕДЕР #}
  {% include "components/header/header.njk" %}

  {# ОСНОВНОЙ КОНТЕНТ #}
  <main id="main-content" class="fade-in">
    {{ content | safe }}
  </main>

  {# ФУТЕР #}
  {% include "components/footer/footer.njk" %}
  
  {# ВИДЖЕТ LAYLA AI #}
  {% include "components/layla-widget/layla-widget.njk" %}

  {# СКРИПТЫ (defer гарантирует загрузку после парсинга HTML) #}
  <script src="/js/main.js" defer></script>
  <script src="/js/layla-widget.js" defer></script>

</body>
</html>