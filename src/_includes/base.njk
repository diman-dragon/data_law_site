<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | DataLaw</title>
  <meta name="description" content="{{ description or 'DataLaw — AI-driven legal intelligence and advocacy.' }}">
  <meta property="og:title" content="{{ title }} | DataLaw">
  <meta property="og:description" content="{{ description or 'DataLaw — AI-driven legal intelligence and advocacy.' }}">
  <meta property="og:type" content="website">

  {# ── ФАВИКОНЫ ── #}
  <link rel="icon" type="image/png" href="{{ '/assets/datalaw-logo-shield.jpg' | url }}">
  <link rel="apple-touch-icon" href="{{ '/assets/datalaw-logo-shield.jpg' | url }}">

  {# ── ШРИФТЫ — только здесь ── #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="https://fonts.gstatic.com/s/dmsans/v15/rP2Fp2K9ki8LcnXeC7-0.woff2" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet">

  {# ── СТИЛИ: токены → глобальные → компоненты → layout-компоненты ── #}
  <link rel="stylesheet" href="{{ '/css/tokens.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/global.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/components.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/pages.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/header.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/footer.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/layla-widget.css' | url }}">
</head>
<body>

  {% include "components/header/header.njk" %}

  <main id="main-content">
    {{ content | safe }}
  </main>

  {% include "components/footer/footer.njk" %}
  {% include "components/layla-widget/layla-widget.njk" %}

  <script src="{{ '/js/main.js' | url }}" defer></script>
  <script src="{{ '/js/layla-widget.js' | url }}" defer></script>

</body>
</html>
