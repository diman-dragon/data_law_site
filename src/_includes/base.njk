<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>

  {# ── ФАВИКОНЫ ── #}
  <link rel="icon" type="image/png" href="{{ '/assets/datalaw-logo-shield.jpg' | url }}">
  <link rel="apple-touch-icon" href="{{ '/assets/datalaw-logo-shield.jpg' | url }}">

  {# ── ШРИФТЫ — только здесь ── #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  {# ── СТИЛИ: токены → глобальные → компоненты → layout-компоненты ── #}
  <link rel="stylesheet" href="{{ '/css/tokens.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/global.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/components.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/pages.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/header.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/footer.css' | url }}">
  <link rel="stylesheet" href="{{ '/css/layla-widget.css' | url }}">
</head>
<body>

  {% include "components/header/header.njk" %}

  <main id="main-content">
    {{ content | safe }}
  </main>

  {% include "components/footer/footer.njk" %}
  {% include "components/layla-widget/layla-widget.njk" %}

  <script src="{{ '/js/main.js' | url }}" defer></script>
  <script src="{{ '/js/layla-widget.js' | url }}" defer></script>

</body>
</html>
