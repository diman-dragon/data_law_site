{% from "macros/section.njk" import section %}
{% from "macros/cta.njk" import cta %}
{% from "macros/card.njk" import card %}

{# --- HERO СЕКЦИЯ --- #}
<section class="home-hero">
  <div class="container">
    <div class="hero-eyebrow animate-in">
      <span class="pulse-dot"></span>
      <span class="eyebrow-text">Система оперативного мониторинга прецедентов</span>
    </div>

    <div class="hero-grid">
      <div>
        <h1 class="main-title animate-in">Право против <br><em>госмашины.</em></h1>
        <p class="lead-description animate-in">DataLaw оцифровывает опыт противостояния неправомерному давлению. Мы строим инструменты симметричного ответа: от глобальных архивов CCF до локального ИИ.</p>
      </div>
      
      <div class="edu-hero-stat-col animate-in" style="border-left: 1px solid var(--border); padding-left: var(--space-lg);">
        <div class="edu-stat">
          <span class="edu-stat-num">50k+</span>
          <span class="edu-stat-label">судебных прецедентов</span>
        </div>
        <div style="display: flex; gap: var(--space-md); margin-top: var(--space-sm);">
          {{ cta("База данных", "/pages/library/") }}
          {{ cta("О нас", "/pages/about/", true) }}
        </div>
      </div>
    </div>
  </div>
</section>

{# --- СЕКЦИЯ НОВОСТЕЙ --- #}
{% call section("", "Последние расследования") %}
  <div class="news-grid-12">
    <div class="news-col-main">
      <article class="article-item" style="border-top: none; border-bottom: 1px solid var(--border); padding-bottom: var(--space-lg);">
        <div class="block-label">Критический анализ · Интерпол</div>
        <h2 style="font-size: 2.8rem; margin-bottom: var(--space-md);">
          <a href="{{ '/pages/interpol/' | url }}" style="color: var(--navy); text-decoration: none;">Злоупотребление Red Notice: Новые паттерны в 2026 году</a>
        </h2>
        <p class="lead-description" style="font-size: 1.15rem;">Исследование DataLaw выявило рост использования обвинений в «кибермошенничестве» как прикрытия для преследования политических активистов. Анализ 40 успешных кейсов отмены в CCF.</p>
        <time class="article-time">28 Февраля, 2026</time>
      </article>
    </div>
    <div class="news-col-side">
      <article style="margin-bottom: var(--space-lg);">
        <div class="block-label">Обновление базы</div>
        <h3 style="font-size: 1.3rem;"><a href="{{ '/pages/practice/' | url }}" style="color: var(--navy); text-decoration: none;">ЕСПЧ: Статья 18. Добавлены решения по делам о скрытых мотивах.</a></h3>
      </article>
      <article>
        <div class="block-label">Технологии</div>
        <h3 style="font-size: 1.3rem;"><a href="{{ '/pages/ai-navigator/' | url }}" style="color: var(--navy); text-decoration: none;">Laila v2.5: Интеграция семантического анализа жалоб в ООН.</a></h3>
      </article>
    </div>
  </div>
{% endcall %}

{# --- DEEP DIVE --- #}
{% call section("Инструментарий", "Когда закон становится оружием, технологии — щитом.", "page-section", "background: var(--navy); color: var(--white);") %}
  <div class="hero-grid" style="align-items: center; gap: 100px;">
    <div>
      <p style="font-size: 1.2rem; opacity: 0.8;">Мы создали DataLaw для работы в условиях, где «облако» — это риск. Наш софт написан на Rust ради абсолютной устойчивости и скорости анализа.</p>
    </div>
  </div>
{% endcall %}

