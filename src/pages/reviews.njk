---
layout: base.njk
title: Обзоры и страновая аналитика — DataLaw
---

{% from "ui/hero.njk" import hero %}
{% from "ui/section.njk" import section %}
{% from "ui/card.njk" import card %}
{% from "ui/button.njk" import button %}

{# --- HERO SECTION --- #}
{{ hero({
  eyebrow: "DataLaw Analytics · Системный мониторинг",
  title: "Обзоры <em>злоупотреблений</em><br>и страновые доклады",
  description: "Мы анализируем массивы данных, чтобы выявить паттерны, скрытые за единичными кейсами.",
  bg: "alt"
}) }}

{# --- ANALYTICS FEED --- #}
{% call section({
  class: "border-t"
}) %}
  <div class="grid grid-3 gap-12 mt-12">
    <div style="grid-column: span 2;">
      {% call card({ title: "Транснациональные репрессии через механизмы Интерпола" }) %}
        <p class="text-lead mb-8">Глобальное исследование об использовании Статьи 3 Устава Интерпола.</p>
        {{ button({ text: "Читать полный текст" }) }}
      {% endcall %}
    </div>
    <aside>
      {% call card({ dark: true, title: "Фокус внимания" }) %}
        <ul style="list-style: none; padding: 0;">
          <li class="mb-4"><a href="#" class="text-white">Казахстан: Антитеррор</a></li>
          <li class="mb-4"><a href="#" class="text-white">Интерпол: Реформы CCF</a></li>
        </ul>
      {% endcall %}
    </aside>
  </div>
{% endcall %}

{# --- CTA BAND --- #}
{% call section({
  bg: "base"
}) %}
  <div class="flex justify-between items-center gap-8">
    <h3 class="text-h2">Нужен специальный анализ?</h3>
    {{ button({ text: "Запросить экспертизу →", href: "/pages/contacts/" }) }}
  </div>
{% endcall %}
