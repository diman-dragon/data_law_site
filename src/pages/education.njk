---
layout: base.njk
title: Образование — DataLaw Academy
---

{% from "ui/hero.njk" import hero %}
{% from "ui/section.njk" import section %}
{% from "ui/card.njk" import card %}
{% from "ui/button.njk" import button %}

{# --- HERO SECTION --- #}
{{ hero({
  eyebrow: "DataLaw Academy · Образовательное направление",
  title: "Технологии — инструмент.<br>Культура знаний — <em>фундамент</em>",
  description: "Academy готовит юристов и сотрудников НКО к работе с международным правом и цифровой безопасностью.",
  stats: [
    { value: "4", label: "направления обучения" },
    { value: "0 ₽", label: "для НКО и адвокатов" }
  ],
  bg: "alt"
}) }}

{# --- DIRECTIONS --- #}
{% call section({
  label: "Направления",
  title: "Чему мы учим",
  class: "border-t"
}) %}
  <div class="grid grid-2 gap-8 mt-12">
    {{ card({
      label: "01 · Право",
      title: "Международная защита",
      description: "Механизмы ЕСПЧ, ООН и Интерпола."
    }) }}
    {{ card({
      label: "02 · Данные",
      title: "OSINT и верификация",
      description: "Фиксация цифровых доказательств по стандартам."
    }) }}
    {{ card({
      label: "03 · Безопасность",
      title: "Цифровая защита",
      description: "Операционная безопасность (OpSec) для адвокатов."
    }) }}
    {{ card({
      label: "04 · Технологии",
      title: "Инструменты DataLaw",
      description: "От поиска в библиотеке до работы в CRM."
    }) }}
  </div>
{% endcall %}

{# --- NGO SECTION --- #}
{% call section({
  label: "Принципы",
  title: "Знания как инструмент защиты",
  bg: "base"
}) %}
  <div class="grid grid-2 gap-12 items-center mt-12">
    <p>DataLaw Academy передает знания и сети поддержки бесплатно тем, кто на переднем крае борьбы.</p>
    {% call card({
      dark: true,
      title: "Для НКО — бесплатно"
    }) %}
      <p class="text-sm opacity-80">Доступ не зависит от бюджета. Программы открыты для некоммерческого сектора.</p>
    {% endcall %}
  </div>
{% endcall %}

{# --- CTA BAND --- #}
{% call section({
  bg: "dark",
  class: "text-white"
}) %}
  <div class="flex justify-between items-center gap-8">
    <div>
      <p class="text-overline mb-2">DataLaw Academy</p>
      <h3 class="text-h2 text-white">Станьте частью сообщества</h3>
    </div>
    {{ button({ text: "Подать заявку →", href: "/pages/contacts/" }) }}
  </div>
{% endcall %}
