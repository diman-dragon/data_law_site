---
layout: base.njk
title: DataLaw CRM — Case Management System
---

{% from "ui/hero.njk" import hero %}
{% from "ui/section.njk" import section %}
{% from "ui/card.njk" import card %}
{% from "ui/button.njk" import button %}

{# --- HERO SECTION --- #}
{% call hero({
  eyebrow: "DataLaw Private Infrastructure · Zero-Knowledge",
  title: "CRM как инструмент <em>стратегической</em><br>защиты прав человека",
  description: "Система управления делами, разработанная для правозащитников. Архитектура нулевого разглашения: ваши данные недоступны даже нам.",
  bg: "alt"
}) %}
  <div class="flex gap-4 mt-8">
    {{ button({ text: "Запросить доступ →", href: "/pages/contacts/" }) }}
    {{ button({ text: "Смотреть демо", href: "/pages/contacts/" }) }}
  </div>
{% endcall %}

{# --- FEATURES GRID --- #}
{% call section({
  label: "Возможности",
  title: "Почему DataLaw CRM?",
  class: "border-t"
}) %}
  <div class="grid grid-3 gap-8 mt-12">
    {{ card({
      title: "Smart-формуляры",
      description: "Автоматическая генерация жалоб в ЕСПЧ, Комитет ООН и CCF Интерпола."
    }) }}
    {{ card({
      title: "Абсолютная анонимность",
      description: "Все данные шифруются на стороне браузера. Мы не храним ваши ключи."
    }) }}
    {{ card({
      title: "Таймлайн преследования",
      description: "Визуальная хроника нарушений: выявляет паттерны системных злоупотреблений."
    }) }}
    {{ card({
      title: "Командная работа",
      description: "Защищённое пространство для совместной работы адвокатов и экспертов."
    }) }}
    {{ card({
      title: "Стратегия защиты",
      description: "Ведите дело параллельно в нескольких инстанциях синхронно."
    }) }}
    {{ card({
      title: "AI-анализ в деле",
      description: "Лайла находит пробелы в доказательной базе прямо в карточке дела."
    }) }}
  </div>
{% endcall %}

{# --- PRESSURE-READY SECTION --- #}
{% call section({
  label: "Безопасность",
  title: "Работа в условиях<br><em>прямого</em> давления",
  description: "CRM спроектирован с допущением, что однажды к вам могут прийти."
}) %}
  <div class="grid grid-2 gap-12 items-center mt-12">
    <div>
      <p>Включает функции: Panic Button, Multi-jurisdiction Backup, Decoy Mode и Tor Native работу.</p>
    </div>
    {% call card({
      dark: true,
      title: "Лайла — внутри дела"
    }) %}
      <p class="text-sm opacity-80 mb-8">Наш AI-ассистент встроен в интерфейс для мгновенного поиска прецедентов.</p>
    {% endcall %}
  </div>
{% endcall %}

{# --- CTA BAND --- #}
{% call section({
  bg: "dark",
  class: "text-white"
}) %}
  <div class="flex justify-between items-center gap-8">
    <div>
      <p class="text-overline mb-2">DataLaw CRM · Бета-доступ</p>
      <h3 class="text-h2 text-white">Защищайте своих клиентов безопаснее</h3>
    </div>
    {{ button({ text: "Запросить доступ →", href: "/pages/contacts/" }) }}
  </div>
{% endcall %}
