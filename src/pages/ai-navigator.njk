{# --- HERO SECTION --- #}
{{ hero({
  eyebrow: "Linguadeck AI · DataLaw Intelligence",
  title: "Лайла — ваш <em>интеллектуальный</em><br>проводник по праву",
  description: "AI-ассистент, обученный на десятках тысяч решений ЕСПЧ, Комитета ООН по правам человека и CCF Интерпола. Лайла анализирует ситуацию, находит релевантные прецеденты и указывает на слабые места в защите.",
  bg: "alt"
}) }}

{# --- FEATURES SECTION --- #}
{% call section({
  label: "Возможности",
  title: "Чем Лайла отличается<br>от обычного поиска",
  class: "border-t"
}) %}
  <div class="grid grid-3 gap-8 mt-12">
    {{ card({ 
      title: "База живых прецедентов", 
      description: "Каждый ответ содержит ссылки на конкретные дела ЕСПЧ, ООН и CCF Интерпола." 
    }) }}
    {{ card({ 
      title: "Оценка шансов", 
      description: "Система сравнивает факты вашего дела с похожими кейсами и помогает увидеть перспективу." 
    }) }}
    {{ card({ 
      title: "Умные шаблоны", 
      description: "Черновики обращений в CCF и ЕСПЧ формируются с учетом актуальных критериев." 
    }) }}
    {{ card({ 
      title: "Интеграция с CRM", 
      description: "Лайла работает прямо в карточке дела: выявляет пробелы и предлагает стратегии." 
    }) }}
    {{ card({ 
      title: "Zero-Knowledge AI", 
      description: "Диалоги не сохраняются и не используются для дообучения. Данные не покидают устройство." 
    }) }}
    {{ card({ 
      title: "Многоязычность", 
      description: "Юридические термины переводятся с сохранением точного процессуального смысла." 
    }) }}
