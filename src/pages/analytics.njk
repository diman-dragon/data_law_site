<script>
  /* ── KPI Counter animation ── */
  (function() {
    const formatNum = (n) => {
      if (n >= 1000000) return (n/1000000).toFixed(1).replace('.0','') + ' млн';
      if (n >= 1000)    return (n/1000).toFixed(0) + ' 000';
      return n.toString();
    };

    const counters = document.querySelectorAll('.kpi-num[data-target]');
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el     = entry.target;
        const target = parseInt(el.dataset.target);
        const dur    = 1600;
        const start  = performance.now();
        (function tick(now) {
          const p = Math.min((now - start) / dur, 1);
          const ease = 1 - Math.pow(1 - p, 3);
          el.textContent = formatNum(Math.round(ease * target));
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = formatNum(target);
        })(start);
        io.unobserve(el);
      });
    }, { threshold: 0.5 });

    counters.forEach(c => io.observe(c));
  })();

  /* ── Bar / Outcome fill animation ── */
  (function() {
    const fills = document.querySelectorAll('.bar-fill, .outcome-fill');
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animated');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    fills.forEach(f => io.observe(f));
  })();
</script>
