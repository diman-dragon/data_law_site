{% from "ui/hero.njk" import hero %}
{% from "ui/section.njk" import section %}
{% from "ui/card.njk" import card %}
{% from "ui/button.njk" import button %}

{# --- HERO SECTION --- #}
{{ hero({
  eyebrow: "Non-Profit Human Rights Technology",
  title: "Там, где право встречается<br>с <em>Big Data</em>",
  description: "Мы создаем технологический противовес госмашине. DataLaw — это цифровая инфраструктура для защиты прав человека.",
  stats: [
    { value: "50k+", label: "решений в базе" },
    { value: "100%", label: "бесплатно для НКО" }
  ],
  bg: "alt"
}) }}

{# --- MANIFESTO SECTION --- #}
{% call section({
  label: "Manifesto",
  title: "Мы NPO — и это не оговорка",
  bg: "dark"
}) %}
  <div class="grid grid-2 gap-12 mt-12">
    <div>
      <p class="text-lead text-muted">Коммерческий LegalTech идет туда, где есть деньги. Мы идем туда, где есть нарушения прав человека.</p>
    </div>
    <div class="grid grid-1 gap-6">
      {{ card({
        title: "Независимость",
        description: "Никаких внешних инвесторов."
      }) }}
      {{ card({
        title: "Симметрия",
        description: "Нейросети на службе защиты."
      }) }}
    </div>
  </div>
{% endcall %}

{# --- ARCHITECTURE --- #}
{% call section({
  label: "Architecture",
  title: "Гибридная модель безопасности",
  class: "border-t"
}) %}
  <div class="grid grid-2 gap-8 mt-12">
    {% call card({ title: "Global Intelligence" }) %}
      <p>Облачный слой для публичных данных. 1.5 млн документов.</p>
    {% endcall %}
    {% call card({ title: "Local Node & CRM" }) %}
      <p>Локальный слой для работы с делами. Zero-Knowledge.</p>
    {% endcall %}
  </div>
{% endcall %}

{# --- CTA BAND --- #}
{% call section({
  bg: "base"
}) %}
  <div class="flex justify-between items-center gap-8">
    <h3 class="text-h2">Станьте частью инфраструктуры</h3>
    {{ button({ text: "Поддержать проект", href: "/pages/contacts/" }) }}
